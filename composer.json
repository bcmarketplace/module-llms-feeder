        }
    ],
    "require": {
        "php": "~8.1||~8.2||~8.3",
        "magento/framework": "^103.0.4",
        "magento/module-config": "^101.2.0",
        "magento/module-store": "^101.1.0",
        "magento/module-backend": "^102.0.0",
        "magento/module-cron": "^100.4.0",
        "magento/module-cms": "^104.0.0",
